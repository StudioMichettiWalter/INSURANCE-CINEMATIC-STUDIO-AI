{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "parent_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "status": {
      "enum": [
        "PREPRODUCTION",
        "ASSETS_PENDING",
        "ASSETS_READY",
        "EDITING",
        "QA",
        "DELIVERED",
        "BLOCKED"
      ]
    },
    "fps": {
      "const": 30
    },
    "locale": {
      "const": "it-IT"
    },
    "brand": {
      "type": "object",
      "properties": {
        "navy": {
          "const": "#0A1628"
        },
        "gold": {
          "const": "#E6C777"
        },
        "ivory": {
          "const": "#F6F1E3"
        }
      },
      "required": [
        "navy",
        "gold",
        "ivory"
      ],
      "additionalProperties": false
    },
    "script": {
      "type": "string",
      "maxLength": 65536
    },
    "storyboard": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "maxLength": 36
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 108000
          },
          "end_frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 108000
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "maxLength": 36
            },
            "maxItems": 128
          },
          "function": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "start_frame",
          "end_frame",
          "asset_ids",
          "function"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "maxLength": 36
          },
          "image": {
            "type": "string",
            "maxLength": 65536
          },
          "video": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "scene_id",
          "image",
          "video"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "maxLength": 36
          },
          "url": {
            "type": "string",
            "maxLength": 4096
          },
          "accessed": {
            "type": "string",
            "maxLength": 64
          },
          "note": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "required": [
          "id",
          "url",
          "accessed",
          "note"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "maxLength": 36
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "maxLength": 64
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8589934592
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[0-9a-f]{64}$",
            "maxLength": 71
          }
        },
        "required": [
          "id",
          "name",
          "sha256",
          "bytes",
          "path"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "parent_sha256",
    "title",
    "status",
    "fps",
    "locale",
    "brand",
    "script",
    "storyboard",
    "prompts",
    "sources",
    "assets"
  ],
  "additionalProperties": false
}
